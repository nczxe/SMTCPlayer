<?xml version="1.0" encoding="utf-8"?>
<!-- 全窗口设置面板：仿 Windows 原生设置应用布局——
     顶部返回栏 + 内容区占满整个窗口，替代原先居中的 ContentDialog -->
<UserControl
    x:Class="SMTCPlayer.WinUI.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Grid Grid.Row="0" Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="36"
                        Padding="8,4">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="设置"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="24" Margin="28,4,28,32">

                <!-- ============ 外观 ============ -->
                <StackPanel Spacing="10">
                    <TextBlock Text="外观"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="选择应用界面的明暗风格"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ThemeSelector"
                                  MaxColumns="3"
                                  SelectionChanged="ThemeSelector_SelectionChanged">
                        <RadioButton x:Name="ThemeSystem" Content="跟随系统" />
                        <RadioButton x:Name="ThemeLight" Content="浅色" />
                        <RadioButton x:Name="ThemeDark" Content="深色" />
                    </RadioButtons>
                    <ToggleSwitch x:Name="ShowAlbumToggle"
                                  Header="显示专辑名称"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Margin="0,4,0,0"
                                  Toggled="ShowAlbumToggle_Toggled" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 关闭行为 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="关闭行为"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="点击窗口关闭按钮时执行的动作。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <RadioButtons x:Name="CloseActionSelector"
                                  SelectionChanged="CloseActionSelector_SelectionChanged">
                        <RadioButton Content="每次询问" />
                        <RadioButton Content="最小化到托盘" />
                        <RadioButton Content="直接退出" />
                    </RadioButtons>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 播放进度校准 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="播放进度校准"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="当显示的播放进度与实际听到的位置不一致时，可手动设置偏移量校准。仅对网易云增强监视器提供的进度生效，最大偏移 ±5 秒。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="PositionOffsetText"
                               Text="当前偏移：+0 ms"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Button x:Name="CalibrateOffsetButton"
                            Content="校准进度偏移"
                            Click="CalibrateOffsetButton_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            MinWidth="160"
                            Margin="0,4,0,0" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 开发者调试 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="开发者选项"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="DebugModeToggle"
                                  Header="调试日志"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Toggled="DebugModeToggle_Toggled" />
                    <TextBlock Text="开启后记录所有 DEBUG 级别日志，关闭后仅记录 INFO 及以上级别。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <Button Click="OpenLogViewerButton_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="36"
                            HorizontalAlignment="Left"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                            <TextBlock Text="打开日志查看器" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton Content="打开日志文件夹"
                                     Click="OpenLogFolder_Click"
                                     FontSize="12"
                                     Padding="0" />
                    <Button Click="OpenDebugConsole_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="36"
                            HorizontalAlignment="Left"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE756;" FontSize="12" />
                            <TextBlock Text="启动调试控制台" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ PIN 管理 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="访问 PIN"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="修改远程访问 PIN，修改后移动端需重新登录。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <Button x:Name="ChangePinButton"
                            Content="修改 PIN"
                            Click="ChangePinButton_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            MinWidth="140" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 局域网与外部协议 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="局域网与外部协议"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="开启后，本机应用可通过 TCP 连接（逐行 NDJSON）与本应用通信：连接后首条消息须为鉴权，随后可发送播放控制指令并订阅播放状态推送。默认仅本机（127.0.0.1）可连。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <ToggleSwitch x:Name="LanEnabledToggle"
                                  Header="启用局域网协议"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Margin="0,4,0,0"
                                  Toggled="LanEnabledToggle_Toggled" />
                    <NumberBox x:Name="LanPortBox"
                               Header="监听端口（1024-65535）"
                               Minimum="1024"
                               Maximum="65535"
                               SmallChange="1"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="LanPortBox_ValueChanged" />
                    <RadioButtons x:Name="LanScopeSelector"
                                  Header="监听范围"
                                  SelectionChanged="LanScopeSelector_SelectionChanged">
                        <RadioButton Content="仅本机（127.0.0.1）" />
                        <RadioButton Content="局域网（0.0.0.0）" />
                    </RadioButtons>
                    <ToggleSwitch x:Name="UriSchemeToggle"
                                  Header="注册 smtcplayer:// 协议"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Margin="0,8,0,0"
                                  Toggled="UriSchemeToggle_Toggled" />
                    <TextBlock Text="允许外部程序通过 smtcplayer:// 唤起本应用（如 smtcplayer://next、smtcplayer://volume?value=50）。无需管理员权限，仅写入当前用户注册表。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 插件 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="插件"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button Click="PluginManagerButton_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            MinWidth="200"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE912;" FontSize="14" />
                            <TextBlock Text="插件管理"
                                       Style="{StaticResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="管理已安装的插件（安装/卸载/启停）"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="PluginCountText"
                               Text="共 0 个插件"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 检查更新 ============ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="更新"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="仅检查新版本并提示，不会自动下载或安装。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="UpdateStatusText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="UpdateNotesText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="WrapWholeWords"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdateButton"
                                Content="检查更新"
                                Click="CheckUpdate_Click"
                                CornerRadius="{ThemeResource CornerRadiusMedium}"
                                MinHeight="36"
                                Padding="16,0" />
                        <Button x:Name="ViewChangelogButton"
                                Content="查看更新日志"
                                Click="ViewChangelog_Click"
                                CornerRadius="{ThemeResource CornerRadiusMedium}"
                                MinHeight="36"
                                Padding="16,0" />
                        <HyperlinkButton x:Name="ReleaseLink"
                                         Content="打开发布页"
                                         Click="ReleaseLink_Click"
                                         FontSize="12"
                                         Padding="0"
                                         Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- ============ 关于 ============ -->
                <StackPanel Spacing="8">
                    <Button Content="关于 SMTC Player"
                            Click="AboutButton_Click"
                            CornerRadius="{ThemeResource CornerRadiusMedium}"
                            MinHeight="40"
                            HorizontalAlignment="Left"
                            MinWidth="200" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
