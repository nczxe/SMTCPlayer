<ContentDialog
    x:Class="SMTCPlayer.WinUI.Dialogs.PinSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置访问 PIN"
    PrimaryButtonText="确定"
    CloseButtonText="跳过"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <StackPanel Spacing="16" MinWidth="360">
        <!-- 图标 + 提示 -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8D7;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                      VerticalAlignment="Center" />
            <TextBlock x:Name="HintText"
                       Text="为远程访问设置 PIN"
                       Style="{StaticResource BodyTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <TextBlock Text="4-16 位字母、数字或安全特殊字符"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="WrapWholeWords" />

        <!-- PIN 输入 -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="NewPinLabel"
                       Text="PIN"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <PasswordBox x:Name="PinInput"
                         PlaceholderText="输入 PIN"
                         CornerRadius="{ThemeResource CornerRadiusMedium}"
                         MaxLength="16"
                         PasswordChanged="PinInput_PasswordChanged" />
        </StackPanel>

        <!-- 确认 PIN -->
        <StackPanel Spacing="6">
            <TextBlock Text="确认 PIN"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <PasswordBox x:Name="PinConfirm"
                         PlaceholderText="再次输入 PIN"
                         CornerRadius="{ThemeResource CornerRadiusMedium}"
                         MaxLength="16"
                         PasswordChanged="PinConfirm_PasswordChanged" />
        </StackPanel>

        <!-- 错误提示 -->
        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Visibility="Collapsed"
                   TextWrapping="WrapWholeWords" />
    </StackPanel>
</ContentDialog>
