<ContentDialog
    x:Class="SMTCPlayer.WinUI.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    CloseButtonText="关闭"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="560" Padding="0">
    <StackPanel Spacing="20" MinWidth="400" Padding="0,8">

        <!-- ============ 主题切换 ============ -->
        <StackPanel Spacing="8">
            <TextBlock Text="外观主题"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="选择应用界面的明暗风格"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <RadioButtons x:Name="ThemeSelector"
                          MaxColumns="3"
                          SelectionChanged="ThemeSelector_SelectionChanged">
                <RadioButton x:Name="ThemeSystem" Content="跟随系统" />
                <RadioButton x:Name="ThemeLight" Content="浅色" />
                <RadioButton x:Name="ThemeDark" Content="深色" />
            </RadioButtons>
        </StackPanel>

        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- ============ 开发者调试 ============ -->
        <StackPanel Spacing="8">
            <TextBlock Text="开发者选项"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="DebugModeToggle"
                          Header="调试日志"
                          OnContent="开启"
                          OffContent="关闭"
                          Toggled="DebugModeToggle_Toggled" />
            <TextBlock Text="开启后记录所有 DEBUG 级别日志，关闭后仅记录 INFO 及以上级别。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords" />
            <HyperlinkButton Content="打开日志文件夹"
                             Click="OpenLogFolder_Click"
                             FontSize="12"
                             Padding="0" />
            <Button Click="OpenDebugConsole_Click"
                    CornerRadius="{ThemeResource CornerRadiusMedium}"
                    MinHeight="36"
                    HorizontalAlignment="Stretch"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE756;" FontSize="12" />
                    <TextBlock Text="启动调试控制台" FontSize="12" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- ============ 网易云 Cookie ============ -->
        <StackPanel Spacing="8">
            <TextBlock Text="网易云账号"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="清除后需要重新扫码登录网易云账号。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords" />
            <Button x:Name="ClearCookiesButton"
                    Content="清除网易云 Cookie"
                    Click="ClearCookiesButton_Click"
                    CornerRadius="{ThemeResource CornerRadiusMedium}"
                    MinHeight="40"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- ============ PIN 管理 ============ -->
        <StackPanel Spacing="8">
            <TextBlock Text="访问 PIN"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="修改远程访问 PIN，修改后移动端需重新登录。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords" />
            <Button x:Name="ChangePinButton"
                    Content="修改 PIN"
                    Click="ChangePinButton_Click"
                    CornerRadius="{ThemeResource CornerRadiusMedium}"
                    MinHeight="40"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- ============ 关于 ============ -->
        <StackPanel Spacing="8">
            <Button Content="关于 SMTC Player"
                    Click="AboutButton_Click"
                    CornerRadius="{ThemeResource CornerRadiusMedium}"
                    MinHeight="40"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</ContentDialog>
