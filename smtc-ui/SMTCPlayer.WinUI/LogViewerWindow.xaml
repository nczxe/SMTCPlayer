<?xml version="1.0" encoding="utf-8"?>
<!-- 内置日志查看器：基于内存环形缓冲实时滚动展示，
     支持暂停/继续、级别与分类过滤、关键字搜索、自动滚动开关与导出当前视图。
     仅消费 SMTCPlayer.Logging 公开 API（LogManager/LogEntry/LogLevel）；
     单例持有与生命周期由 MainWindow 负责，本窗口关闭即由宿主清引用。 -->
<Window
    x:Class="SMTCPlayer.WinUI.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：暂停/继续 + 自动滚动 + 导出视图 + 打开日志文件夹 + 统计反馈 -->
        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PauseButton"
                        Click="PauseButton_Click"
                        CornerRadius="{ThemeResource CornerRadiusMedium}"
                        MinHeight="36"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                        <TextBlock x:Name="PauseText" Text="暂停" FontSize="12" />
                    </StackPanel>
                </Button>
                <ToggleSwitch x:Name="AutoScrollToggle"
                              IsOn="True"
                              OnContent="自动滚动"
                              OffContent="自动滚动"
                              MinWidth="0"
                              VerticalAlignment="Center" />
                <Button x:Name="ExportButton"
                        Click="ExportButton_Click"
                        CornerRadius="{ThemeResource CornerRadiusMedium}"
                        MinHeight="36"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="导出视图" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton"
                        Click="OpenFolderButton_Click"
                        CornerRadius="{ThemeResource CornerRadiusMedium}"
                        MinHeight="36"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="打开日志文件夹" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text=""
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- 过滤行：最低级别 + 分类 + 关键字搜索 -->
        <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="LevelFilter"
                      Header="最低级别"
                      MinWidth="130"
                      SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="CategoryFilter"
                      Grid.Column="1"
                      Header="分类"
                      MinWidth="200"
                      SelectionChanged="Filter_Changed" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     Header="关键字搜索"
                     PlaceholderText="过滤消息或分类…"
                     TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- 日志行（代码构建 TextBlock，按级别着色；开启横向滚动查看长行） -->
        <ListView x:Name="LogList"
                  Grid.Row="4"
                  SelectionMode="None"
                  Padding="12,8,12,12"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Window>
