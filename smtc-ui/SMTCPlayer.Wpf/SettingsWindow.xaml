<Window x:Class="SMTCPlayer.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="620" Width="420"
        Background="{DynamicResource BgPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="500" MinWidth="380"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="端口" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="服务监听端口" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBox x:Name="PortTextBox" Grid.Column="1" Width="110" TextAlignment="Center"
                                 Style="{DynamicResource DarkTextBox}" Text="8888" MaxLength="5"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机自启" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Windows 启动时自动运行" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{DynamicResource ModernCheckBox}"
                                  AutomationProperties.Name="开机自启"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="启动时最小化" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="启动时隐藏到系统托盘" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeOnStartCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{DynamicResource ModernCheckBox}"
                                  AutomationProperties.Name="启动时最小化"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="关闭时最小化" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="点击关闭按钮最小化到托盘" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeOnCloseCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{DynamicResource ModernCheckBox}" IsChecked="True"
                                  AutomationProperties.Name="关闭时最小化"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="网易云音乐 Cookie" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="清除已保存的登录凭据" FontSize="10" Margin="0,2,0,12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button x:Name="ClearCookiesButton" Content="清除 Cookie" Style="{DynamicResource SecondaryButton}" FontSize="11"
                                Padding="16,8" Click="ClearCookies_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="外观" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="切换深色与亮色模式" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="DarkModeCheckBox" VerticalAlignment="Center"
                                      Style="{DynamicResource ModernCheckBox}"
                                      Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"
                                      AutomationProperties.Name="深色模式"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开发者调试模式" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="显示实时日志调试窗口" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="DebugModeCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{DynamicResource ModernCheckBox}" Checked="DebugMode_Changed" Unchecked="DebugMode_Changed"
                                  AutomationProperties.Name="开发者调试模式"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="退出应用" Style="{DynamicResource SecondaryButton}" Click="ExitApp_Click"
                    Foreground="{DynamicResource DangerBrush}" Margin="0,0,12,0"/>
            <Button Content="取消" Style="{DynamicResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,12,0"/>
            <Button Content="保存" Style="{DynamicResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
