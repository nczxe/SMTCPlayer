<Window x:Class="SMTCPlayer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SMTCPlayer.Core.ViewModels;assembly=SMTCPlayer.Core"
        Title="SMTC Player" Height="720" Width="420" MinHeight="400" MinWidth="520"
        Background="{DynamicResource BgPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        SizeChanged="MainWindow_SizeChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" FillBehavior="HoldEnd"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.4" FillBehavior="HoldEnd"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Height="48" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SMTC" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text=" Player" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Style="{DynamicResource SecondaryButton}" Content="设置" FontSize="11"
                            Padding="12,6" Click="Settings_Click" Margin="0,0,8,0"
                            AutomationProperties.Name="打开设置"/>
                    <Button x:Name="MinimizeBtn" Style="{DynamicResource SecondaryButton}" Content="最小化" FontSize="11"
                            Padding="12,6" Click="Minimize_Click"
                            AutomationProperties.Name="最小化窗口"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MainContent">

                <!-- 启动页面：竖屏 / 横屏通用 -->
                <Grid x:Name="StartGrid" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,32">
                            <TextBlock Text="♫" FontSize="56" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="SMTC Player" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>
                            <TextBlock Text="远程遥控电脑播放" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                       Margin="0,6,0,40"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="端口" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Text="{Binding Port}" Width="100" TextAlignment="Center"
                                         Style="{DynamicResource DarkTextBox}" MaxLength="5"/>
                            </StackPanel>

                            <Button Content="启动服务" Style="{DynamicResource AccentButton}"
                                    Command="{Binding StartServerCommand}" HorizontalAlignment="Center" Padding="48,14"
                                    AutomationProperties.Name="启动远程控制服务"/>

                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,16,0,40"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="设置" Style="{DynamicResource SecondaryButton}" Click="Settings_Click" Margin="0,0,8,0"
                                        AutomationProperties.Name="打开设置"/>
                                <Button Content="退出" Style="{DynamicResource SecondaryButton}" Click="Quit_Click"
                                        Foreground="{DynamicResource DangerBrush}"
                                        AutomationProperties.Name="退出应用"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 竖屏模式：高 > 宽，单栏滚动 -->
                <Grid x:Name="PortraitGrid" Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource CardBorder}" Margin="16,16,16,8" Grid.Row="0" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="P_AlbumBorder" Grid.Column="0" Width="120" Height="120" CornerRadius="12"
                                    Background="{DynamicResource BgTertiaryBrush}" Margin="0,0,20,0">
                                <Image x:Name="P_AlbumImage" Stretch="UniformToFill" Width="112" Height="112">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,112,112" RadiusX="8" RadiusY="8"/>
                                    </Image.Clip>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Artist}" FontSize="12" Margin="0,4,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,8">
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Style="{DynamicResource DarkProgressBar}"
                                     Height="6"/>
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="{Binding PositionText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,16">
                        <Button Content="⏮" Style="{DynamicResource ControlButton}" FontSize="16"
                                Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}"
                                AutomationProperties.Name="上一首"/>
                        <Button x:Name="P_PlayPauseBtn" Content="▶" Style="{DynamicResource PlayButton}" Margin="16,0"
                                Command="{Binding PlayPauseCommand}"
                                AutomationProperties.Name="播放/暂停"/>
                        <Button Content="⏭" Style="{DynamicResource ControlButton}" FontSize="16"
                                Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}"
                                AutomationProperties.Name="下一首"/>
                    </StackPanel>

                    <Border Style="{DynamicResource CardBorder}" Margin="16,0" Grid.Row="3" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="P_VolumeIcon" Content="🔊" Style="{DynamicResource IconButton}" FontSize="16"
                                    Click="VolumeIcon_Click" Grid.Column="0" Margin="0,0,12,0"
                                    AutomationProperties.Name="切换静音"/>

                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{DynamicResource ModernSlider}" VerticalAlignment="Center" MinWidth="60"/>

                            <TextBlock Grid.Column="2" Text="{Binding VolumeValue, StringFormat='{}{0:F0}%'}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Width="36" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardBorder}" Margin="16,0,16,8" Grid.Row="4" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="系统状态" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding HealthText}" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource CardBorder}" Margin="16,8" Grid.Row="5" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="P_QrBorder" Width="100" Height="100" CornerRadius="8" Background="{DynamicResource BgTertiaryBrush}"
                                    Grid.Column="0" Margin="0,0,16,0">
                                <Image x:Name="P_QrImage" Stretch="Uniform" Width="92" Height="92"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="扫码控制" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding LanUrl}" FontSize="10" Margin="0,4,0,12"
                                           Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand"
                                           MouseLeftButtonDown="CopyUrl_Click" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="复制" Style="{DynamicResource SecondaryButton}" FontSize="11"
                                            Padding="12,6" Command="{Binding CopyUrlCommand}" Margin="0,0,8,0"
                                            AutomationProperties.Name="复制控制链接"/>
                                    <Button Content="打开" Style="{DynamicResource AccentButton}" FontSize="11"
                                            Padding="12,6" Click="OpenBrowser_Click"
                                            AutomationProperties.Name="在浏览器中打开"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button Content="托盘" Style="{DynamicResource SecondaryButton}" Click="MinimizeToTray_Click" Margin="0,0,8,4"
                                AutomationProperties.Name="最小化到系统托盘"/>
                        <Button Content="改PIN" Style="{DynamicResource SecondaryButton}" Click="ChangePin_Click" Margin="0,0,8,4"
                                AutomationProperties.Name="修改访问 PIN"/>
                        <Button Content="关于" Style="{DynamicResource SecondaryButton}" Click="About_Click" Margin="0,0,8,4"
                                AutomationProperties.Name="关于"/>
                        <Button Content="退出" Style="{DynamicResource SecondaryButton}" Click="Quit_Click"
                                Foreground="{DynamicResource DangerBrush}"
                                AutomationProperties.Name="退出应用"/>
                    </WrapPanel>
                </Grid>

                <!-- 横屏模式：宽 >= 高，左右三栏 -->
                <Grid x:Name="LandscapeGrid" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                      MaxWidth="1000" MinHeight="360">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：大封面 + 曲目信息 -->
                    <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="16,16,8,16" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="L_AlbumBorder" Grid.Row="0" CornerRadius="16"
                                        Background="{DynamicResource BgTertiaryBrush}"
                                        HorizontalAlignment="Center" Width="180" Height="180">
                                    <Image x:Name="L_AlbumImage" Stretch="UniformToFill" Width="168" Height="168">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,168,168" RadiusX="12" RadiusY="12"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="13" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- 中栏：进度条 + 控制按钮 + 音量 -->
                    <Grid Grid.Column="1" Margin="0,16,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource CardBorder}" Margin="8,0" Padding="24">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,8">
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Style="{DynamicResource DarkProgressBar}"
                                                     Height="8"/>
                                        <Grid Margin="0,20,0,0">
                                            <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,24">
                                        <Button Content="⏮" Style="{DynamicResource ControlButton}" FontSize="18"
                                                Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}"
                                                AutomationProperties.Name="上一首"/>
                                        <Button x:Name="L_PlayPauseBtn" Content="▶" Style="{DynamicResource PlayButton}" Margin="20,0"
                                                Command="{Binding PlayPauseCommand}" FontSize="22"
                                                AutomationProperties.Name="播放/暂停"/>
                                        <Button Content="⏭" Style="{DynamicResource ControlButton}" FontSize="18"
                                                Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}"
                                                AutomationProperties.Name="下一首"/>
                                    </StackPanel>

                                    <Border Style="{DynamicResource CardBorder}" Padding="16,14" Margin="0,8,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="L_VolumeIcon" Content="🔊" Style="{DynamicResource IconButton}" FontSize="18"
                                                    Click="VolumeIcon_Click" Grid.Column="0" Margin="0,0,14,0"
                                                    AutomationProperties.Name="切换静音"/>

                                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                    Value="{Binding VolumeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{DynamicResource ModernSlider}" VerticalAlignment="Center" MinWidth="60"/>

                                            <TextBlock Grid.Column="2" Text="{Binding VolumeValue, StringFormat='{}{0:F0}%'}" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}" Width="42" TextAlignment="Right"
                                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{DynamicResource CardBorder}" Padding="14,10" Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="系统状态" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding HealthText}" FontSize="11" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 右栏：二维码 + 快捷操作 -->
                    <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Margin="8,16,16,16" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel VerticalAlignment="Stretch">
                                <TextBlock Text="扫码控制" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LanUrl}" FontSize="11" Margin="0,6,0,16"
                                           Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand" HorizontalAlignment="Center"
                                           MouseLeftButtonDown="CopyUrl_Click" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>

                                <Border x:Name="L_QrBorder" CornerRadius="12" Background="{DynamicResource BgTertiaryBrush}"
                                        HorizontalAlignment="Center" Width="150" Height="150" Margin="0,0,0,16">
                                    <Image x:Name="L_QrImage" Stretch="Uniform" Width="140" Height="140"/>
                                </Border>

                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Button Content="复制链接" Style="{DynamicResource SecondaryButton}" FontSize="11"
                                            Padding="12,6" Command="{Binding CopyUrlCommand}" Margin="0,0,8,4"
                                            AutomationProperties.Name="复制控制链接"/>
                                    <Button Content="浏览器打开" Style="{DynamicResource AccentButton}" FontSize="11"
                                            Padding="12,6" Click="OpenBrowser_Click" Margin="0,0,8,4"
                                            AutomationProperties.Name="在浏览器中打开"/>
                                </WrapPanel>

                                <Separator Background="{DynamicResource BorderPrimaryBrush}" Height="1" Margin="0,12,0,12" Opacity="0.6"/>

                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="托盘" Style="{DynamicResource SecondaryButton}" Click="MinimizeToTray_Click" Margin="0,0,8,4"
                                            AutomationProperties.Name="最小化到系统托盘"/>
                                    <Button Content="改PIN" Style="{DynamicResource SecondaryButton}" Click="ChangePin_Click" Margin="0,0,8,4"
                                            AutomationProperties.Name="修改访问 PIN"/>
                                    <Button Content="关于" Style="{DynamicResource SecondaryButton}" Click="About_Click" Margin="0,0,8,4"
                                            AutomationProperties.Name="关于"/>
                                    <Button Content="退出" Style="{DynamicResource SecondaryButton}" Click="Quit_Click"
                                            Foreground="{DynamicResource DangerBrush}"
                                            AutomationProperties.Name="退出应用"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
