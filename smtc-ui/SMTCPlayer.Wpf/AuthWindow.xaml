<Window x:Class="SMTCPlayer.Wpf.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMTC Player 认证"
        Width="340" MaxHeight="620" SizeToContent="Height"
        Background="{DynamicResource BgPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

            <TextBlock x:Name="SubtitleText" Grid.Row="1" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

            <PasswordBox x:Name="PinBox" Grid.Row="2" Style="{DynamicResource DarkPasswordBox}"
                         FontSize="14" Padding="12,10" MaxLength="16"
                         AutomationProperties.Name="访问 PIN"/>

            <TextBlock x:Name="ConfirmLabel" Grid.Row="3" Text="确认 PIN" FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>

            <PasswordBox x:Name="ConfirmBox" Grid.Row="4" Style="{DynamicResource DarkPasswordBox}"
                         FontSize="14" Padding="12,10" MaxLength="16"
                         AutomationProperties.Name="确认 PIN"/>

            <TextBlock x:Name="ErrorText" Grid.Row="5" FontSize="10"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{DynamicResource SecondaryButton}"
                        Padding="24,10" Click="Cancel_Click" Margin="0,0,12,0" IsCancel="True"/>
                <Button Content="确定" Style="{DynamicResource AccentButton}"
                        Padding="32,10" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
